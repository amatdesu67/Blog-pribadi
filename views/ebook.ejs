<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container page">
  <a href="/projects" class="back-link">&larr; Projects</a>

  <div class="ebook-cover">
    <p class="eyebrow">Panduan Berpikir Kritis</p>
    <h1><%= ebook.title %></h1>
    <p class="page-lead"><%= ebook.subtitle %></p>
    <p class="muted" style="margin-top: 1rem;"><%= ebook.edition %> &middot; oleh <%= ebook.author %></p>

    <div class="ebook-stats">
      <div class="estat"><strong><%= stats.chapters %></strong><span>bab</span></div>
      <div class="estat"><strong><%= stats.pages %></strong><span>halaman</span></div>
      <div class="estat"><strong>&plusmn;<%= stats.minutes %> mnt</strong><span>waktu baca</span></div>
    </div>

    <div class="hero-actions" style="justify-content: flex-start; margin-top: 1.75rem;">
      <a class="btn btn-primary" href="/ebook/<%= chapters[0].slug %>">Baca online</a>
      <a class="btn btn-ghost" href="<%= stats.pdfUrl %>" download>Download PDF (<%= stats.pdfSize %>)</a>
    </div>
  </div>

  <h2 class="toc-title section-label">~/daftar-isi</h2>
  <ol class="toc">
    <% chapters.forEach(function (c) { %>
      <li>
        <a href="/ebook/<%= c.slug %>">
          <span class="toc-num"><%= String(c.number).padStart(2, "0") %></span>
          <span class="toc-text"><%= c.title %></span>
        </a>
      </li>
    <% }) %>
  </ol>

</main>

<%- include('partials/footer') %>

<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container page contact-page-wrap">
  <div class="page-hero">
    <p class="section-label">~/kontak</p>
    <h1>Ngobrol yuk.</h1>
    <p class="page-lead">Pertanyaan, masukan, atau mau diskusi proyek — kirim aja.</p>
  </div>

  <div class="contact-page">
    <div>
      <% if (sent) { %>
        <div class="alert alert-success">Terima kasih! Pesan lo udah masuk — gw baca secepatnya.</div>
      <% } %>

      <% if (errors.length > 0) { %>
        <div class="alert alert-error">
          <ul style="margin: 0; padding-left: 1.2em;">
            <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <form class="form" method="POST" action="/contact">
        <div class="hp-field" aria-hidden="true">
          <label>Jangan isi kolom ini
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <label>
          Nama
          <input type="text" name="name" value="<%= values.name || '' %>" required />
        </label>
        <label>
          Email
          <input type="email" name="email" value="<%= values.email || '' %>" required />
        </label>
        <label>
          Pesan
          <textarea name="message" rows="6" required><%= values.message || '' %></textarea>
        </label>
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 8px;">
          <button class="btn btn-primary" type="submit">Kirim pesan</button>
          <button class="btn btn-ghost" type="button" id="btnWhatsapp">Kirim via WhatsApp</button>
        </div>
      </form>
    </div>

    <aside class="contact-alt">
      <h2 class="section-label" style="margin-bottom: 1rem;">~/langsung</h2>
      <ul class="social-list">
        <li><a class="u-line" href="<%= social.whatsapp.url %>" target="_blank" rel="noopener">WhatsApp — <%= social.whatsapp.label %></a></li>
        <li><a class="u-line" href="<%= social.instagram.url %>" target="_blank" rel="noopener">Instagram — <%= social.instagram.label %></a></li>
        <li><a class="u-line" href="<%= social.tiktok.url %>" target="_blank" rel="noopener">TikTok — <%= social.tiktok.label %></a></li>
        <li><a class="u-line" href="mailto:<%= social.email %>">Email — <%= social.email %></a></li>
      </ul>
    </aside>
  </div>
</main>

<%- include('partials/footer') %>

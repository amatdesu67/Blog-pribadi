<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="read-progress" id="readProgress" aria-hidden="true"></div>

<main class="container page ebook-reader">
  <a href="/ebook" class="back-link">&larr; Daftar isi</a>

  <header class="chapter-header">
    <p class="eyebrow">Bab <%= chapter.number %> &middot; <%= ebook.title %></p>
    <h1><%= chapter.title %></h1>
  </header>

  <article class="prose"><%- contentHtml %></article>

  <nav class="chapter-nav">
    <% if (prev) { %>
      <a class="chapter-nav-item prev" href="/ebook/<%= prev.slug %>">
        <span>&larr; Sebelumnya</span><strong><%= prev.title %></strong>
      </a>
    <% } else { %><span></span><% } %>

    <% if (next) { %>
      <a class="chapter-nav-item next" href="/ebook/<%= next.slug %>">
        <span>Selanjutnya &rarr;</span><strong><%= next.title %></strong>
      </a>
    <% } else { %><span></span><% } %>
  </nav>
</main>

<%- include('partials/footer') %>

<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  var waBase = social.whatsapp.url.split("?")[0];
  var waText = encodeURIComponent("Halo Riza, aku tertarik dengan jasa pembuatan website kamu. Boleh diskusi?");
  var waLink = waBase + "?text=" + waText;
%>

<main class="container page">
  <div class="page-hero">
    <p class="section-label">~/jasa</p>
    <h1>Butuh website yang <span class="grad">beneran jalan</span>?</h1>
    <p class="page-lead">
      Dari landing page bisnis, toko online, sampai web app custom dengan
      integrasi AI — dibangun pakai Node.js &amp; Express, bisa lo cek sendiri hasilnya.
    </p>
    <div class="hero-actions" style="justify-content: flex-start; margin-top: 1.5rem;">
      <a class="btn btn-primary" href="<%= waLink %>" target="_blank" rel="noopener">Chat via WhatsApp</a>
      <a class="btn btn-ghost" href="#harga">Lihat Harga</a>
    </div>
  </div>

  <section class="section">
    <div class="section-head"><h2>Yang bisa gw kerjakan</h2></div>
    <div class="card-grid">
      <div class="card">
        <span class="badge">Landing Page</span>
        <h3>Landing Page Bisnis</h3>
        <p>Profil usaha, etalase produk/jasa, tombol kontak. Cocok buat UMKM yang mau tampil profesional — kayak Cofus Coffee.</p>
      </div>
      <div class="card">
        <span class="badge">Toko Online</span>
        <h3>Toko Online Sederhana</h3>
        <p>Katalog produk, keranjang, alur checkout. Seperti yang gw bangun di Anto Computer.</p>
      </div>
      <div class="card">
        <span class="badge">App Custom</span>
        <h3>Web App Custom</h3>
        <p>Form, dashboard, sampai integrasi AI sesuai kebutuhan. Tinggal diskusi maunya seperti apa.</p>
      </div>
    </div>
  </section>

  <section class="section" id="harga">
    <div class="section-head"><h2>Harga</h2></div>
    <div class="price-grid">
      <div class="price-card">
        <p class="price-name">Landing Page</p>
        <p class="price-num">Rp 300rb+</p>
        <ul class="price-list">
          <li>1 halaman, beberapa section</li>
          <li>Responsif (HP &amp; desktop)</li>
          <li>Tombol kontak / WhatsApp</li>
        </ul>
        <a class="btn btn-ghost" href="<%= waLink %>" target="_blank" rel="noopener">Pesan</a>
      </div>
      <div class="price-card price-featured">
        <span class="price-tag">Paling laris</span>
        <p class="price-name">Toko Online</p>
        <p class="price-num">Rp 750rb+</p>
        <ul class="price-list">
          <li>Katalog produk</li>
          <li>Keranjang &amp; checkout</li>
          <li>Kelola data sederhana</li>
        </ul>
        <a class="btn btn-primary" href="<%= waLink %>" target="_blank" rel="noopener">Pesan</a>
      </div>
      <div class="price-card">
        <p class="price-name">App Custom</p>
        <p class="price-num">Rp 1jt+</p>
        <ul class="price-list">
          <li>Form / dashboard</li>
          <li>Integrasi AI (opsional)</li>
          <li>Sesuai kebutuhan</li>
        </ul>
        <a class="btn btn-ghost" href="<%= waLink %>" target="_blank" rel="noopener">Pesan</a>
      </div>
    </div>
    <p class="muted price-note" style="margin-top: 1rem;">
      *Harga "mulai dari" — final menyesuaikan kebutuhan &amp; kerumitan. Diskusi dulu, gratis.
    </p>
  </section>

  <section class="section">
    <div class="section-head"><h2>Kenapa gw?</h2></div>
    <div class="card-grid">
      <div class="card">
        <h3>Ada bukti nyata</h3>
        <p>Bukan janji kosong — hasil kerja gw bisa lo buka langsung: Cofus Coffee, Anto Computer, Nalar.</p>
      </div>
      <div class="card">
        <h3>Komunikasi langsung</h3>
        <p>Ngobrol langsung via WhatsApp, tanpa perantara. Cepat, santai, jelas.</p>
      </div>
      <div class="card">
        <h3>Revisi wajar</h3>
        <p>Revisi dalam batas wajar sudah termasuk, biar hasilnya pas sama yang lo mau.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Contoh karya</h2>
      <a href="/projects" class="link-more u-line">Semua proyek</a>
    </div>
    <div class="proj-index">
      <% showcase.forEach(function (p, i) { %>
        <a class="proj-row" href="/projects/<%= p.slug %>">
          <span class="page-num"><%= String(i + 1).padStart(2, "0") %></span>
          <div>
            <h3><%= p.title %></h3>
            <p><%= p.tagline %></p>
          </div>
          <span class="proj-type"><%= p.type %> &middot; <%= p.year %></span>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Why work with me?</h2></div>
    <div class="card-grid">
      <div class="card"><h3>Fokus produk nyata</h3><p>Semua portofolio gw live dan bisa lo klik langsung — bukan sekadar mockup.</p></div>
      <div class="card"><h3>Terbiasa dari nol</h3><p>Server, database, UI, deploy — gw pegang dari ujung ke ujung.</p></div>
      <div class="card"><h3>Cepat belajar</h3><p>Teknologi baru bukan halangan: AI API, animasi, 3D — dipelajari sambil dipakai.</p></div>
      <div class="card"><h3>Mengutamakan pengguna</h3><p>Yang penting bukan kodenya keren, tapi pengunjung betah & ngerti harus ngapain.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="cta-box">
      <h2>Siap mulai project lo?</h2>
      <p>Ceritakan idenya — gw bantu wujudkan jadi website yang beneran jalan.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="<%= waLink %>" target="_blank" rel="noopener">Chat via WhatsApp</a>
        <a class="btn btn-ghost" href="mailto:<%= social.email %>">Email Gw</a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>

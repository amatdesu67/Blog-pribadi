<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="container page">
  <div class="page-hero">
    <p class="section-label">~/proyek</p>
    <h1>Dibuat sambil belajar.</h1>
    <p class="page-lead">Tiap proyek = satu pelajaran baru. Semuanya bisa dicoba langsung.</p>
  </div>

  <div class="tag-row tag-filter" data-proj-filter>
    <button class="tag is-active" data-filter="all">Semua</button>
    <button class="tag" data-filter="Web App">Web App</button>
    <button class="tag" data-filter="Ebook">Ebook</button>
  </div>

  <div class="proj-index">
    <% projects.forEach(function (p, i) { %>
      <a class="proj-row" href="/projects/<%= p.slug %>" data-type="<%= p.type %>">
        <span class="page-num"><%= String(i + 1).padStart(2, "0") %></span>
        <div>
          <h3><%= p.title %></h3>
          <p><%= p.tagline %></p>
        </div>
        <span class="proj-type"><%= p.type %> &middot; <%= p.year %></span>
      </a>
    <% }) %>
  </div>
</main>

<%- include('partials/footer') %>

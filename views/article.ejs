<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="read-progress" id="readProgress" aria-hidden="true"></div>

<main class="container page article-page">
  <a href="/blog" class="back-link">&larr; Semua tulisan</a>

  <article>
    <header class="article-header">
      <time><%= formatTanggal(article.created_at) %></time>
      <h1><%= article.title %></h1>
      <div class="tag-row">
        <% article.tags.forEach(function (t) { %>
          <a href="/blog/tag/<%= encodeURIComponent(t) %>" class="tag tag-sm">#<%= t %></a>
        <% }) %>
      </div>
    </header>

    <div class="prose"><%- contentHtml %></div>
  </article>
</main>

<%- include('partials/footer') %>

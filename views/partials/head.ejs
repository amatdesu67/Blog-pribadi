<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
    const desc = typeof pageDescription !== "undefined"
      ? pageDescription
      : "Blog & portofolio pribadi Ahmad Riza Rudi — web developer & penulis.";
    const pageTitle = title + " — Ahmad Riza Rudi";
    const url = typeof canonical !== "undefined" ? canonical : "";
    const ogImage = (typeof siteUrl !== "undefined" ? siteUrl : "") + "/og-image.png";
    const isHome = typeof active !== "undefined" && active === "home";
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= desc %>" />
  <meta name="theme-color" content="#0a0a0a" />
  <% if (url) { %><link rel="canonical" href="<%= url %>" /><% } %>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Ahmad Riza Rudi" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= desc %>" />
  <% if (url) { %><meta property="og:url" content="<%= url %>" /><% } %>
  <meta property="og:image" content="<%= ogImage %>" />
  <meta property="og:image:width" content="1600" />
  <meta property="og:image:height" content="900" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= pageTitle %>" />
  <meta name="twitter:description" content="<%= desc %>" />
  <meta name="twitter:image" content="<%= ogImage %>" />

  <!-- Font: Inter (pengganti SF Pro) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Logger error client-side (dipertahankan dari versi lama) -->
  <script>
    window.addEventListener("error", function (e) {
      try {
        fetch("/client-log", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            type: "error", message: e.message, source: e.filename,
            line: e.lineno, column: e.colno,
            error: e.error ? e.error.stack : null
          })
        });
      } catch (_) {}
    });
    window.addEventListener("unhandledrejection", function (e) {
      try {
        fetch("/client-log", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            type: "unhandledrejection",
            message: e.reason ? e.reason.message : "Unknown rejection",
            reason: String(e.reason),
            error: e.reason && e.reason.stack ? e.reason.stack : null
          })
        });
      } catch (_) {}
    });
  </script>

  <!-- Animasi: GSAP + ScrollTrigger + Lenis (defer — non-blocking) -->
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/lenis@1.1.18/dist/lenis.min.js"></script>

  <% if (isHome) { %>
  <!-- Three.js hanya di Beranda (hero 3D). Module = otomatis deferred. -->
  <script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js"
    }
  }
  </script>
  <% } %>
</head>
<body<% if (isHome) { %> class="is-home"<% } %>>

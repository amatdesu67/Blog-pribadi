<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
    // Deskripsi bisa di-override per halaman lewat variabel `pageDescription`.
    const desc = typeof pageDescription !== "undefined"
      ? pageDescription
      : "Blog & portofolio pribadi Ahmad Riza Rudi — siswa SMK TKJ yang belajar ngoding & menulis.";
    const pageTitle = title + " — Ahmad Riza Rudi";
    const url = typeof canonical !== "undefined" ? canonical : "";
    // Gambar preview (Open Graph). Pakai URL absolut karena WA/FB butuh itu.
    const ogImage = (typeof siteUrl !== "undefined" ? siteUrl : "") + "/og-image.png";
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= desc %>" />
  <% if (url) { %><link rel="canonical" href="<%= url %>" /><% } %>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Open Graph / Twitter (preview saat link dibagikan ke WA, IG, dll) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Ahmad Riza Rudi" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= desc %>" />
  <% if (url) { %><meta property="og:url" content="<%= url %>" /><% } %>
  <meta property="og:image" content="<%= ogImage %>" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= pageTitle %>" />
  <meta name="twitter:description" content="<%= desc %>" />
  <meta name="twitter:image" content="<%= ogImage %>" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <!-- Pasang tema sebelum halaman tampil supaya tidak 'kedip' (anti-FOUC). -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem("theme");
        if (!t) {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    })();
  </script>
</head>
<body>
